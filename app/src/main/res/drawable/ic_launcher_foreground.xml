<?xml version="1.0" encoding="utf-8"?>
<!--
  Cadence icon: EKG heartbeat pulse (left) transitioning into audio waveform bars (right).
  Represents the app's core concept — biometric signal becomes music.
  Safe zone: 18–90 in 108×108 viewport.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- EKG / heartbeat pulse on the left half -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 22,54 L 31,54 L 35,46 L 40,63 L 44,39 L 49,70 L 53,54 L 58,54"/>

    <!-- Waveform bars on the right half — left-to-right cadence rhythm -->
    <!-- Bar 1 (short) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:pathData="M 65,44 L 65,64"/>

    <!-- Bar 2 (tall) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:pathData="M 74,32 L 74,76"/>

    <!-- Bar 3 (medium) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:pathData="M 83,38 L 83,70"/>

</vector>
