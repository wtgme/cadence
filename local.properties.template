# Copy this file to local.properties and fill in your values.
# local.properties is git-ignored — never commit API keys.

sdk.dir=/path/to/android/sdk

# ── Step 1: Signal2Style (biometrics → song style) ──────────────────────────
# Any OpenAI-compatible chat/completions endpoint.
# Examples:
#   OpenRouter : https://openrouter.ai/api/v1
#   Self-hosted: https://chat.cadencemusics.uk/v1
signal2style.base.url=https://chat.cadencemusics.uk/v1
signal2style.api.key=YOUR_API_KEY_OR_DUMMY_IF_SELF_HOSTED
signal2style.model=google/gemma-4-26B-A4B-it

# ── Step 2: SongGeneration (song style → MP3) ───────────────────────────────
# Use http://10.0.2.2:8888/v1/music_generation for emulator against a local server,
# or http://<phone-ip>:8888/v1/music_generation for a physical device on the same LAN.
songgen.base.url=https://api.cadencemusics.uk/v1/music_generation
songgen.api.key=YOUR_API_KEY_OR_DUMMY_IF_SELF_HOSTED
songgen.model=SongGeneration-v2-large

# ── Release signing (required for Play Store uploads) ───────────────────────
# Generate a keystore once with:
#   keytool -genkey -v -keystore ~/cadence-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias cadence
# Back it up — if you lose this file you can never update the app on Play Store.
release.keystore.path=/absolute/path/to/cadence-release.jks
release.keystore.password=YOUR_KEYSTORE_PASSWORD
release.key.alias=cadence
release.key.password=YOUR_KEY_PASSWORD
